---
// Renders a Portable Text embed block. YouTube and Vimeo URLs become a
// responsive 16:9 iframe styled by `.video-embed` in global.css; any other URL
// falls back to a plain link.
interface Props {
	node: {
		_type: 'embed';
		url?: string;
		caption?: string;
	};
}

const { url, caption } = Astro.props.node;

function embedUrl(input: string): string | null {
	const youtube = input.match(
		/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/,
	);
	if (youtube) return `https://www.youtube-nocookie.com/embed/${youtube[1]}`;

	const vimeo = input.match(/vimeo\.com\/(\d+)/);
	if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;

	return null;
}

const src = url ? embedUrl(url) : null;
const isWebLink = url ? /^https?:\/\//.test(url) : false;
---

{
	src ? (
		<div class="video-embed">
			<iframe
				src={src}
				title={caption || 'Embedded video'}
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
				loading="lazy"
			/>
		</div>
	) : (
		isWebLink && (
			<p>
				<a href={url} target="_blank" rel="noopener noreferrer">
					{url}
				</a>
			</p>
		)
	)
}
