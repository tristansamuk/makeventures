---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HomeSection from "../components/HomeSection.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import type { Project } from "./projects/index.astro";

// ── Featured projects ── edit this array to change which projects are shown
const FEATURED_PROJECT_IDS: string[] = [
  // "beside-lights",
  // "lab-desk",
  // "outdoor-stair-decay",
];

const [allProjects, allPosts] = await Promise.all([
  getCollection("projects"),
  getCollection("blog"),
]);

/**
 * Filters three featured projects to display on the homepage.
 * If the `FEATURED_PROJECT_IDS` array is empty, falls back to the three
 * most recent projects.
 * @param allProjects: `Project[]`
 */
const getProjectsForDisplay = (allProjects: Project[]) => {
  if (!allProjects.length) return [];

  if (!FEATURED_PROJECT_IDS.length) {
    return allProjects.slice(0, 3);
  }

  return FEATURED_PROJECT_IDS.map((id) =>
    allProjects.find((proj) => proj.id === id),
  );
};

const projects = getProjectsForDisplay(allProjects);

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Hero />

      <HomeSection
        title="Featured Projects"
        href="/projects"
        linkLabel="All projects"
        layout="grid"
      >
        {projects.map((proj) => proj && <ProjectCard project={proj} />)}
      </HomeSection>

      <HomeSection
        title="Recent Posts"
        href="/blog"
        linkLabel="All posts"
        layout="list"
      >
        {recentPosts.map((post) => <PostRow post={post} />)}
      </HomeSection>
    </main>
    <Footer />
  </body>
</html>
