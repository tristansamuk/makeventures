---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE_TITLE } from '../../../consts';
import { getPosts, getTag } from '../../../lib/content';

const param = Astro.params.tag ?? '';
const tag = await getTag(param);

if (!tag) {
	// Tag URLs used the tag's original casing before the move to EmDash (`/blog/tags/AI/`).
	const legacy = param !== param.toLowerCase() && (await getTag(param.toLowerCase()));
	return legacy ? Astro.redirect(`/blog/tags/${legacy.slug}/`, 301) : Astro.rewrite('/404');
}

const posts = await getPosts({ tag: tag.slug });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`#${tag.label} — ${SITE_TITLE}`}
			description={`All posts tagged with "${tag.label}"`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<p class="page-eyebrow">Tag</p>
				<h1>{tag.label}</h1>
				<p class="page-subtitle">
					{posts.length} post{posts.length !== 1 ? 's' : ''}
				</p>
			</header>

			<ul class="post-grid" role="list">
				{posts.map((post) => <PostCard post={post} />)}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: var(--sp-12);
		padding-bottom: var(--sp-8);
		border-bottom: 1px solid var(--color-border);
	}
	.page-eyebrow {
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		font-weight: 500;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--sp-2);
	}
	.page-header h1 {
		margin-bottom: var(--sp-2);
	}
	.page-subtitle {
		font-family: var(--font-mono);
		font-size: var(--fs-sm);
		color: var(--color-ink-muted);
		margin: 0;
	}
	.post-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--sp-8);
	}
	@media (max-width: 720px) {
		.post-grid {
			grid-template-columns: 1fr;
			gap: var(--sp-5);
		}
	}
</style>
